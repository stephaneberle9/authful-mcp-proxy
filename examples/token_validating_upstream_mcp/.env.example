# JWT verification settings for the minimal example upstream MCP server.
#
# Discover OIDC configuration from your IdP:
#   curl https://auth.company.com/.well-known/openid-configuration | jq .
#
# `JWT_ISSUER` and `JWT_JWKS_URI` are required; the others are optional but
# recommended for production-shaped testing.

JWT_ISSUER="https://auth.company.com"
JWT_JWKS_URI="https://auth.company.com/.well-known/jwks.json"
JWT_AUDIENCE="mcp-production-api"
JWT_REQUIRED_SCOPES="read:data,write:data"
